{
  "$schema": "https://turbo.build/schema.json",
  // Turbo 2 runs tasks in STRICT env mode: a task only sees env vars that are
  // declared below (plus a few system ones like PATH/HOME). Without these
  // lists `npm run dev` silently dropped DATABASE_URL / PORT / … and the api
  // fell back to localhost defaults. `passThroughEnv` = available at runtime
  // but NOT part of the cache hash (right for dev servers and DB-backed tests);
  // `env` = available AND hashed (right for values baked into build output).
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      // Vite inlines VITE_* into the web bundle, so they must bust the cache.
      // The /connect page also bakes the web and API ports (issue 117).
      "env": ["VITE_*", "MC_WEB_PORT", "PORT", "MC_API_PORT"]
    },
    // `npm run dev` → api `dev` (nest start --watch) + web `dev` (vite) in
    // parallel. Both workspaces MUST define a `dev` script or turbo skips them.
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "PORT",
        "MC_API_PORT",
        "MC_WEB_PORT",
        "HOST",
        "WEB_ORIGIN",
        "INGEST_TOKEN",
        "SOCKET_TOKEN",
        "GITHUB_TOKEN",
        "HEALTH_TICK_MS",
        "OPENCLAW_GATEWAY_HOST",
        "OPENCLAW_GATEWAY_PORT",
        "MC_COMPOSE",
        "GATEWAY_STATUS_MAX_AGE_MS",
        "OPENCLAW_LOG_DIR",
        "OPENCLAW_CONFIG_PATH",
        "GIT_SHA",
        // Display-only operator name (default ticket/run assignee) — ticket 3.
        "OPERATOR_NAME",
        "NODE_ENV",
        "VITE_*"
      ]
    },
    // `npm test` runs each workspace `test` script. Specs that boot the API
    // use TEST_DATABASE_URL. When that is set, setup reads DATABASE_URL only
    // to see if both URLs are the same database, and refuses before it writes.
    // If DATABASE_URL is unset or cannot be reached, that read is skipped. When
    // TEST_DATABASE_URL is unset, setup creates a throwaway database from the
    // server in DATABASE_URL and does not write to the live database. Neither
    // value is hashed. The task is not cached. INGEST_TOKEN is not forwarded:
    // those specs clear it and set their own value. Workspaces without a test
    // script are skipped.
    "test": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    // `npm run test:e2e` → api e2e against a real, migrated Postgres at
    // DATABASE_URL. Never cached: the result depends on live DB state.
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    }
  }
}
