// Mission Control — Prisma schema (v2: live data layer).
//
// SECURITY (vibe-dev-workflow red line): database schema is a never-vibe
// domain. v2 adds the tables the live feed needs (activity events, sessions,
// tickets, cron jobs, usage, approvals) and extends Agent/Run. Human review
// before landing on main.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts (see file next to schema).
datasource db {
  provider = "postgresql"
}

/// Agent roster. `source` is who owns the row:
/// `default` (seeded roster), `snapshot` (OpenClaw bridge), or `registered`
/// (POST /agents/register). A snapshot may create, update, or remove only
/// `snapshot` rows. Identity for new rows is `id`, a lowercase slug.
/// `position` is roster order and does not change when a row is registered.
/// `lastSeenAt` is set on register and heartbeat. The API reports a registered
/// bot offline after OFFLINE_AFTER_MS (default 10 minutes). Rows are never auto deleted.
model Agent {
  id              String    @id @default(cuid())
  /// Display name. Not unique: a snapshot may add another row with the same name and a different id.
  name            String
  color           String    @default("#58A6FF")
  role            String?
  status          String    @default("idle") // working | idle
  parentId        String?
  parent          Agent?    @relation("AgentTree", fields: [parentId], references: [id])
  children        Agent[]   @relation("AgentTree")
  emoji           String? // avatar emoji, e.g. "🛠️"
  personalityTags Json? // array of short tags, e.g. ["strategist","daily","integrator"]
  currentTask     String?
  tasksCompleted  Int       @default(0)
  totalCost       Float     @default(0)
  recentActivity  String?
  channel         String? // Discord channel/thread link or handle (bridge-supplied)
  /// default | snapshot | registered
  source          String    @default("default")
  model           String?
  /// Optional picture from POST /agents/register. Robot art stays the roster.
  avatar          String?
  /// Roster order. Registering an existing id does not change this.
  position        Int       @default(0)
  lastSeenAt      DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([source])
}

/// Scheduled runs / jobs observed by the dashboard (Morning Brief, Trend Radar, ...).
/// v2: agent + progress added so Tasks can show live, per-agent work.
model Run {
  id         String    @id @default(cuid())
  name       String
  agent      String?
  status     String    @default("queued") // queued | running | done | failed | needs_approval
  progress   Int       @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  /// Pipeline matches a run to a ticket by this id only (QA-13). Null when
  /// the run is not tied to a ticket; the page then uses the ticket's createdAt.
  ticketId   String?
  ticket     Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

/// A named group of tickets (ticket 4).
///
/// Archive is a flag (`archivedAt`), not a delete: the row stays, its
/// tickets stay, and GET /projects hides it unless asked. A ticket points
/// at most at one project (`Ticket.projectId`, nullable).
///
/// `nameKey` is the case-folded name. It is the UNIQUE column so
/// "Roadmap" and "roadmap" cannot both exist. The API writes it whenever
/// `name` changes; the unique index (not a pre-check) is what makes a
/// duplicate a real constraint error, which the controller turns into 409.
/// Blank names are rejected in the controller with 400 — there is no CHECK
/// constraint, because a check failure would surface as 500.
model Project {
  id         String    @id @default(cuid())
  name       String
  nameKey    String    @unique
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tickets    Ticket[]
}

/// Kanban/backlog items. Status: backlog | todo | inprogress | done.
/// `projectId` is optional: a ticket belongs to one project or to none.
model Ticket {
  id        String   @id @default(cuid())
  key       String?
  title     String
  status    String   @default("backlog")
  priority  String   @default("med") // high | med | low
  assignee  String?
  tags      Json?
  points    Int?
  /// Nullable on purpose. ON DELETE SET NULL in the migration: dropping a
  /// project row must not delete its tickets (archive is the supported path).
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Optional note. Empty when the caller omitted it.
  description String @default("")
  createdAt DateTime @default(now())
  runs      Run[]

  @@index([projectId])
}

/// Active agent sessions — pushed by the bridge (sessions.snapshot).
model Session {
  id           String   @id @default(cuid())
  name         String
  agent        String
  model        String?
  ctx          Int      @default(0)
  lastActivity String?
  hot          Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

/// Cron jobs / scheduled routines — pushed by the bridge (calendar.snapshot).
model CronJob {
  id        String   @id @default(cuid())
  name      String
  schedule  String?
  day       Int?
  time      String?
  color     String?
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// One collected usage day. The bridge posts timestamped points
/// (`usage.snapshot`); 24h, 7 day, and month views sum `at`.
/// `day` is the calendar day in the saved timezone and the upsert key.
/// Re-posting a day replaces that row. Other days stay.
model UsageBucket {
  id        String   @id @default(cuid())
  day       String   @unique
  at        DateTime
  totalCost Float    @default(0)
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  providers Json?
  updatedAt DateTime @updatedAt

  @@index([at])
}

/// Every ingested/broadcast event — persisted so pages can load history.
model ActivityEvent {
  id      String   @id @default(cuid())
  type    String
  payload Json?
  source  String   @default("openclaw")
  ts      DateTime @default(now())

  @@index([ts])
}

/// Approval requests — pushed by the bridge (approvals.snapshot) and decided here.
/// meta holds structured details (e.g. PR number/url/branch for kind='pr').
model Approval {
  id        String   @id @default(cuid())
  kind      String // exec | pair | msg | sess | pr
  tag       String
  desc      String
  status    String   @default("pending") // pending | approved | rejected
  meta      Json?
  createdAt DateTime @default(now())
}

/// One remembered note. Written by memory.snapshot (bridge) or seed:demo.
/// The web app reads this table and does not open OpenClaw files.
/// `id` is stable (agent + path, or a fixed demo id) so a re-sync updates
/// the same row. Day groups are not stored: the API buckets `createdAt`
/// into calendar days in the saved timezone.
model MemoryEntry {
  id        String   @id
  title     String
  body      String
  agent     String
  createdAt DateTime
  kind      String // long-term | daily | other
  source    String? // bridge | demo
  ref       String? // workspace-relative path when the bridge has one
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([kind])
}

/// One provider and model from `models.snapshot`.
/// The bridge replaces every row. This table is not a live balance.
/// `agentId` and `agentName` name the OpenClaw agent when the config has one.
/// `local` is true for Ollama and any provider the config marks local.
model ModelConfig {
  id        String   @id @default(cuid())
  provider  String
  model     String
  label     String?
  agentId   String?
  agentName String?
  local     Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Dashboard settings. Ticket 7 stores the team mission on one row
/// (`id` = "default"). The API upserts that row. An empty mission is
/// valid; the Team page shows its placeholder instead of a saved line.
/// Length is enforced in the controller (400), not with a CHECK, so a
/// too-long value cannot surface as 500.
model Setting {
  id               String   @id
  mission          String   @default("")
  /// Reported by models.snapshot. Null until the bridge has read a version.
  openclawVersion  String?
  /// crew or own. Null until the first run choice is saved.
  namingMode       String?
  /// Agent id to crew seat id. The screen applies it only when namingMode is crew.
  /// A matching id takes a free seat. A saved seat stays. The earliest agent
  /// without a seat takes a seat that opens. Those writes share one lock.
  crewMap          Json?
  /// IANA timezone for usage and memory days. Null uses the server timezone.
  timezone         String?
  /// True after the first open is finished or skipped.
  setupDone        Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

/// A machine listed on the Team page. `npm run seed:demo` writes three
/// sample rows (`source` demo). `devices.snapshot` writes live rows
/// (`source` bridge) from OpenClaw devices and nodes. `online` is true
/// only when the source reported a live connection. `lastSeenAt` is a
/// real last seen time, never the pairing time. `pairedAt` is when it
/// was paired. `requestedAt` is a pending request. `kind` is device or
/// node so one failed CLI does not wipe the other.
model Device {
  id          String    @id
  name        String
  type        String
  online      Boolean   @default(false)
  lastSeenAt  DateTime?
  pairedAt    DateTime?
  requestedAt DateTime?
  source      String    @default("demo")
  kind        String    @default("device")
  updatedAt   DateTime  @updatedAt
}

/// Experimental custom tool (ticket 10). A named prompt template plus the
/// inputs it fills. `name` is unique after the API trims it. `inputs` is a
/// JSON array of `{ name, label? }`. Placeholders in `promptTemplate` use
/// `{{name}}` and must match an input name. A preview substitutes those
/// values in-process — this table is not a license to call OpenClaw.
model CustomTool {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String   @default("")
  promptTemplate String
  inputs         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
