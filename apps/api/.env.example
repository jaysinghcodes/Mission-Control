# Mission Control API environment template.
# The API process does not load this file, and it does not load apps/api/.env.
# Copy the repo root .env.example to .env at the repo root, then export it
# before npm run dev:
#   set -a; . ./.env; set +a
# Never commit the real .env.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mission_control

# API
PORT=3000
HOST=127.0.0.1
# CORS allowlist, comma separated
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Shared secret for agent ingest, sent as x-ingest-token.
# Blank on loopback leaves ingest open outside production (one warning).
# Production with no token returns 401 on ingest. Blank on any other HOST
# refuses to start. See the root .env.example.
INGEST_TOKEN=change-me

# Retired. Dashboard login replaced the socket token. Leave this blank.
SOCKET_TOKEN=

# scrypt hash of the dashboard password. Blank on loopback leaves the dashboard open.
DASHBOARD_PASSWORD_HASH=
# HMAC secret for the session cookie. Required with the hash when HOST is not loopback.
SESSION_SECRET=
# Session version file. Default is apps/api/data/session-state.json.
# Compose uses /data/auth/session-state.json. A stored hash overrides
# DASHBOARD_PASSWORD_HASH on startup.
# SESSION_STATE_PATH=
# Wrong passwords per client IP. Defaults: 5 failures, 60 second window,
# first wait 60 seconds, later waits double up to 900 seconds.
# Loopback is not limited. Blank or invalid uses the default.
# LOGIN_FAIL_LIMIT=5
# LOGIN_WINDOW_SECONDS=60
# LOGIN_BACKOFF_MAX_SECONDS=900
# Extra proxies that may supply X-Forwarded-For. Leave blank for Compose.
# The bundled nginx is BUNDLED_PROXY (default web), not this list.
# TRUSTED_PROXY=
# BUNDLED_PROXY=

# GitHub. Enables PR approvals to auto merge from Mission Control
GITHUB_TOKEN=

# OpenClaw gateway. Native installs probe this address. The defaults are
# 127.0.0.1 and 18789. Under Compose, leave the host blank. The bridge on
# the host checks 127.0.0.1 and posts the result. Set the host only when
# the API itself should probe that address.
# OPENCLAW_GATEWAY_HOST=127.0.0.1
# OPENCLAW_GATEWAY_PORT=18789
# Compose bridge report max age in milliseconds. Blank, 0, or invalid
# uses 600000 (10 minutes). Older than that, or missing, is Unknown.
# GATEWAY_STATUS_MAX_AGE_MS=600000

# Gateway log directory. Default is /tmp/openclaw.
# OPENCLAW_LOG_DIR=/tmp/openclaw

# Git commit. Unset in a checkout reads git. The Docker image also reads git-sha.txt.
# GIT_SHA=

# Operator display name (not a secret). Default assignee for new
# tickets and runs. Blank becomes the neutral "Operator".
OPERATOR_NAME=

# Server timezone when Settings has not saved one.
# TZ=UTC

# Registered bots go offline after this many milliseconds. Default is 10 minutes.
# OFFLINE_AFTER_MS=600000

# Health ticker interval (ms). 0 disables it.
HEALTH_TICK_MS=30000

# How many usage days a snapshot may keep, through today. Default is 30.
# USAGE_RETENTION_DAYS=30
