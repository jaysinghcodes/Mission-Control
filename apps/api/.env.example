# Mission Control API — environment template (copy to apps/api/.env)
# Never commit the real .env.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mission_control

# API
PORT=3000
HOST=127.0.0.1
# CORS allowlist — comma-separated
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Shared secret for the event bridge
INGEST_TOKEN=change-me

# Socket feed secret — required by the api in production (socket handshake guard)
SOCKET_TOKEN=

# GitHub — enables PR approvals → auto-merge from Mission Control
GITHUB_TOKEN=

# Provider keys — enables LIVE balances in Health/Usage
DEEPSEEK_API_KEY=
ZAI_API_KEY=

# Operator display name (not a secret) — default assignee for new
# tickets/runs. Blank → neutral "Operator".
OPERATOR_NAME=

# Health ticker interval (ms)
HEALTH_TICK_MS=30000
