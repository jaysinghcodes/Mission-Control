server {
    listen 5173;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Same origin API. The browser calls /api/... with its session cookie.
    # This proxy does not attach a write token. The prefix is stripped:
    # /api/health is the API's /health.
    location /api/ {
        proxy_pass http://api:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Same origin live feed. Socket.IO uses this path on the page origin.
    # The browser sends the session cookie. This proxy does not add a token.
    location /socket.io/ {
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # SPA fallback (HashRouter also works, but keep this for safety)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
