{
  "name": "mission-control",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && node --test scripts/doctor.test.mjs scripts/fresh-clone.test.mjs",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "seed:demo": "npm run seed:demo --workspace api",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "turbo": "^2.5.0"
  }
}
