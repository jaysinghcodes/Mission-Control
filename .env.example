# ── Mission Control environment (copy to .env and fill in) ──────────────
# Never commit the real .env. This file is the public template.

# Database. npm run seed:demo on the host uses this URL.
# bash install.sh sets the port from MC_DB_PORT (shell, then .env, then 5432) on a new file.
# A later run updates this URL only when it is still this stock host and port and a new MC_DB_PORT is passed.
# A custom URL is left as is. Compose points the API at the db service on container port 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mission_control

# Operator (display only, not a secret, never used for auth)
# Your name as shown in the dashboard: the account chip and the default
# assignee for new tickets/runs. Leave blank for a neutral first run
# ("Good evening" / assignee "Operator"). Docker: compose passes OPERATOR_NAME
# to the api AND bakes it into the web bundle (VITE_OPERATOR_NAME build arg).
# Without Docker, `npm run dev` also needs VITE_OPERATOR_NAME (Vite only exposes
# VITE_* vars to the browser).
OPERATOR_NAME=
VITE_OPERATOR_NAME=
# Optional: your OWN Discord server id. Only used to turn a bare channel id
# pushed by the bridge (agent.channel) into a deep link on the Team profile
# drawer. Blank (default) means bare ids render no link. Full URLs always work.
VITE_DISCORD_GUILD_ID=

# API
PORT=3000
HOST=127.0.0.1
# CORS allowlist, comma separated. Both localhost spellings work via tunnel.
# Leave it commented out unless you need a custom origin.
# Local dev: the api built-in default is exactly this pair.
# Docker compose: the default is DERIVED from MC_WEB_PORT below
# (http://localhost:$MC_WEB_PORT,http://127.0.0.1:$MC_WEB_PORT), so moving
# the web port keeps CORS working. Setting WEB_ORIGIN here overrides that.
# If you set it, keep its port in sync with MC_WEB_PORT.
# WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── docker compose host ports (QA-1 polish item 6) ──────────────────────
# Change these when 5432 / 3000 / 5173 are already taken on your machine.
# Only the host side moves; services talk on the defaults inside compose.
# MC_DB_PORT=5432
# MC_API_PORT=3000
# MC_WEB_PORT=5173
# Tunnel listener for Cloudflare Tunnel and Tailscale Serve.
# The local web port stays the owner port. SSH uses that port.
# Only the host side moves. nginx listens on 3011 inside the container.
# MC_REMOTE_PORT=3011
# Optional API origin baked into the web bundle at build time.
# Leave this unset. The browser then uses the web port. nginx (compose) and
# the Vite dev server proxy /api and /socket.io to the API.
# Set it only when the browser should call a different origin, then rebuild
# the web image: docker compose up -d --build
# VITE_API_URL=http://localhost:3000
# Shared secret for agent ingest only: POST /events, POST /agents/register,
# POST /agents/:id/heartbeat, POST /runs, and PATCH /runs/:id.
# Send it as the header x-ingest-token. Dashboard reads and writes do not
# use this header. They use the session cookie when the caller is not loopback.
# Unset, with HOST on loopback (127.0.0.1, localhost, or ::1): ingest stays
# open outside production and the API logs one warning. Production with no
# token returns 401 on ingest even on loopback. Unset, with HOST on any other
# address (compose uses 0.0.0.0 inside the container): the API refuses to start.
# bash install.sh writes a random value when it creates .env. It never writes
# the placeholder below, and a second run does not replace an existing value.
# Generate a real value with: openssl rand -hex 24
# A blank value stays blank. Compose does not invent a token.
INGEST_TOKEN=change-me

# Retired. Issue 36 baked this into the web bundle for the socket handshake.
# Dashboard login replaced it. The installer does not generate a value.
# Leave this blank. The web image does not receive it.
SOCKET_TOKEN=

# Dashboard password, stored as scrypt:N:r:p:saltHex:keyHex.
# Colons, not dollar signs, so `set -a; . ./.env; set +a` does not expand it.
# bash install.sh writes this when it is missing and prints the password once.
# A second run does not replace a hash that is already set.
# Blank, with HOST on loopback: the dashboard stays open.
# Blank, with HOST on any other address, or under Compose: the API refuses to start.
DASHBOARD_PASSWORD_HASH=
# Signs the mc_session cookie. bash install.sh writes 32 random bytes as hex
# when this is missing. A second run does not replace it.
SESSION_SECRET=
# How long the session cookie lasts, in seconds. Default is 7 days.
# Allowed range is 60 seconds through 30 days.
# SESSION_MAX_AGE_SECONDS=604800
# Session version and a changed password hash. Logout and a password change
# bump the version, so an old cookie returns 401 after a restart. Default is
# apps/api/data/session-state.json. Compose uses /data/auth/session-state.json
# on the mc-auth volume. When the file stores a hash, that hash overrides
# DASHBOARD_PASSWORD_HASH on startup. Delete the file before you edit the
# hash in this file by hand.
# SESSION_STATE_PATH=
# Wrong dashboard passwords per client IP. Loopback is not counted.
# Agent ingest is not counted. After LOGIN_FAIL_LIMIT failures inside
# LOGIN_WINDOW_SECONDS, the next try is HTTP 429 with a Retry-After header,
# even when the password is right. The first wait matches the window. Each
# later lockout doubles up to LOGIN_BACKOFF_MAX_SECONDS. A blank or invalid
# value uses the default. The counters reset when the API process restarts.
# LOGIN_FAIL_LIMIT=5
# LOGIN_WINDOW_SECONDS=60
# LOGIN_BACKOFF_MAX_SECONDS=900
# Comma separated proxy addresses (IP or IPv4 CIDR) allowed to supply
# X-Forwarded-For for the login bucket. Loopback is the socket address
# only. This list does not skip login. Leave this unset for Compose. Do not
# set it to the Docker bridge. A client can spoof the leftmost hop.
# TRUSTED_PROXY=
# Hostname or IP of the bundled nginx. Compose sets this to the web service
# name (default web) and the API resolves it on the Compose network. A blank
# value outside Compose trusts no extra peer. The API trusts X-MC-Remote
# only from this peer. npm run login:reset clears a login lock. Under
# Compose the lock message names: docker compose exec api npm run login:reset
# BUNDLED_PROXY=

# GitHub. Enables PR approvals to auto merge from Mission Control.
GITHUB_TOKEN=

# OpenClaw gateway. Native installs probe this address. The defaults are
# 127.0.0.1 and 18789. Under Compose, leave the host blank. The bridge on
# the host checks 127.0.0.1 and posts the result. Set the host only when
# the API itself should probe that address. extra_hosts still maps
# host.docker.internal for that override.
# OPENCLAW_GATEWAY_HOST=127.0.0.1
# OPENCLAW_GATEWAY_PORT=18789
# How long a Compose bridge report stays fresh, in milliseconds.
# Blank, 0, or an invalid number uses 600000 (10 minutes). Older than that
# shows Unknown. A missing report is Unknown too. Unknown is not Down.
# GATEWAY_STATUS_MAX_AGE_MS=600000

# Gateway log directory. Default is /tmp/openclaw.
# OPENCLAW_LOG_DIR=/tmp/openclaw

# Git commit baked into the API image at build time.
# A checkout reads git when this is unset. Docker passes it as a build arg.
# GIT_SHA=

# OpenClaw config for the bridge models snapshot. Default is ~/.openclaw/openclaw.json.
# OPENCLAW_CONFIG_PATH=

# Docs library. Directory of markdown the API reads. The browser never sees
# a filesystem path. It asks for a server issued id or a root relative slug.
# Unset means <repo>/data/docs, which `npm run seed:demo` fills. Docker Compose
# bind-mounts this HOST path at /data/docs inside the api container and sets
# the container's DOCS_ROOT to /data/docs, so a host seed and the API share
# the folder. Leave this unset unless you want a different host directory.
# A missing or empty directory is an empty Docs page, not an error.
# DOCS_ROOT=

# Bridge schedule. bash install.sh uses these when the openclaw command is on PATH.
# The shell wins over this file for that run. A new .env stores those shell values.
# An existing .env is not rewritten.
# Interval between bridge runs, in seconds. 300 is 5 minutes.
MC_BRIDGE_INTERVAL_SECONDS=300
# Doctor fails when a bridge schedule is installed and the last successful sync is older than this many seconds.
# With no schedule, that age stays an info line.
MC_BRIDGE_STALE_SECONDS=600
# 1 also calls POST /agents/register. 0 posts snapshots only.
MC_BRIDGE_REGISTER=1
# MC_API_URL=http://127.0.0.1:3000
# MC_BRIDGE_STAMP_FILE=
# MC_BRIDGE_LOG=
# MC_BRIDGE_PYTHON=
# Optional PATH for the schedule. Unset uses the openclaw directory, the python3 directory, then the PATH at install time.
# MC_BRIDGE_PATH=
# MC_BRIDGE_SCHEDULER=
# MC_BRIDGE_RUN_NOW=1

# Server timezone when Settings has not saved one. Compose passes this into the API.
# TZ=UTC
# Registered bots go offline after this many milliseconds without a heartbeat. Default is 10 minutes.
# OFFLINE_AFTER_MS=600000
# Socket health.tick interval in milliseconds. 0 disables it. Default is 30000.
# HEALTH_TICK_MS=30000
# How many usage days a snapshot may keep, through today. Default is 30.
# USAGE_RETENTION_DAYS=30
