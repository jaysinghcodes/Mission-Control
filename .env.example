# ── Mission Control environment (copy to .env and fill in) ──────────────
# Never commit the real .env. This file is the public template.

# Database (local dev default; docker compose overrides with the db service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mission_control

# Operator (display only, not a secret, never used for auth)
# Your name as shown in the dashboard: the Overview greeting and the default
# assignee for new tickets/runs. Leave blank for a neutral first run
# ("Good evening" / assignee "Operator"). Docker: compose passes OPERATOR_NAME
# to the api AND bakes it into the web bundle (VITE_OPERATOR_NAME build arg).
# Without Docker, `npm run dev` also needs VITE_OPERATOR_NAME (Vite only exposes
# VITE_* vars to the browser).
OPERATOR_NAME=
VITE_OPERATOR_NAME=
# Optional: your OWN Discord server id. Only used to turn a bare channel id
# pushed by the bridge (agent.channel) into a deep link on the Team profile
# drawer. Blank (default) means bare ids render no link. Full URLs always work.
VITE_DISCORD_GUILD_ID=

# API
PORT=3000
HOST=127.0.0.1
# CORS allowlist, comma separated. Both localhost spellings work via tunnel.
# Leave it commented out unless you need a custom origin.
# Local dev: the api built-in default is exactly this pair.
# Docker compose: the default is DERIVED from MC_WEB_PORT below
# (http://localhost:$MC_WEB_PORT,http://127.0.0.1:$MC_WEB_PORT), so moving
# the web port keeps CORS working. Setting WEB_ORIGIN here overrides that.
# If you set it, keep its port in sync with MC_WEB_PORT.
# WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── docker compose host ports (QA-1 polish item 6) ──────────────────────
# Change these when 5432 / 3000 / 5173 are already taken on your machine.
# Only the host side moves; services talk on the defaults inside compose.
# MC_DB_PORT=5432
# MC_API_PORT=3000
# MC_WEB_PORT=5173
# Optional API origin baked into the web bundle at build time.
# Leave this unset. The browser then uses the web port. nginx (compose) and
# the Vite dev server proxy /api and /socket.io to the API.
# Set it only when the browser should call a different origin, then rebuild
# the web image: docker compose up -d --build
# VITE_API_URL=http://localhost:3000
# Shared secret for every API write (POST, PUT, PATCH, DELETE), including
# POST /events. Send it as the header x-ingest-token. The web UI does not
# put this value in the browser: Vite (dev) and nginx (compose) attach it
# on same origin /api requests.
# Unset, with HOST on loopback (127.0.0.1, localhost, or ::1): writes stay
# open and the API logs one warning. Unset, with HOST on any other address
# (compose uses 0.0.0.0 inside the container): the API refuses to start.
# bash install.sh writes a random value when it creates .env. It never writes
# the placeholder below, and a second run does not replace an existing value.
# Generate a real value with: openssl rand -hex 24
# A blank value makes Compose use dev-ingest-token. The installer does not leave it blank.
INGEST_TOKEN=change-me

# Socket feed secret. Guards the dashboard Socket.IO connection when the api
# runs in production (NODE_ENV=production). Docker injects this into the
# api container and bakes it into the web bundle (VITE_SOCKET_TOKEN build arg).
# bash install.sh writes a random value when it creates .env.
# A blank value uses dev-socket-token. The installer does not leave it blank.
SOCKET_TOKEN=

# GitHub. Enables PR approvals to auto merge from Mission Control.
GITHUB_TOKEN=

# Provider keys. Enables live balances in Health and Usage (DeepSeek only today).
DEEPSEEK_API_KEY=
ZAI_API_KEY=

# Docs library. Directory of markdown the API reads. The browser never sees
# a filesystem path. It asks for a server issued id or a root relative slug.
# Unset means <repo>/data/docs, which `npm run seed:demo` fills. Docker Compose
# bind-mounts this HOST path at /data/docs inside the api container and sets
# the container's DOCS_ROOT to /data/docs, so a host seed and the API share
# the folder. Leave this unset unless you want a different host directory.
# A missing or empty directory is an empty Docs page, not an error.
# DOCS_ROOT=
